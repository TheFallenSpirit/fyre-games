{
	"name": "fyre-games",
	"type": "module",
	"version": "0.0.1",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm run build && pnpm run start --dev",
		"build": "rm -r build; tsc && tsc-alias",
		"start": "node -r dotenv/config build/src/app.js",
		"lint:check": "prettier .",
		"lint:write": "prettier . --write"
	},
	"prettier": {
		"tabWidth": 4,
		"printWidth": 120,
		"singleQuote": true,
		"trailingComma": "none"
	},
	"dependencies": {
		"@fallencodes/seyfert-utils": "^1.6.0",
		"dotenv": "^17.4.2",
		"ioredis": "^5.10.1",
		"itty-time": "^2.0.2",
		"mongoose": "^9.6.1",
		"seyfert": "^4.3.0",
		"yunaforseyfert": "^1.1.3"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"tsc-alias": "^1.8.17",
		"typescript": "^6.0.3"
	}
}
